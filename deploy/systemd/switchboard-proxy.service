[Unit]
Description=Switchboard STARTTLS proxy (SMTP submission, IMAP, POP3)
After=network-online.target switchboard-tproxy.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/switchboard proxy
Restart=on-failure
RestartSec=2
User=haproxy
Group=haproxy
# IP_TRANSPARENT for usesrc-style upstream connections
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/haproxy /etc/switchboard
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
