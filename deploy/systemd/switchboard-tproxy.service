[Unit]
Description=Switchboard transparent mode routing
After=network-online.target netfilter-persistent.service
Wants=network-online.target
Before=haproxy.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/switchboard/tproxy-setup.sh
ExecStart=/usr/lib/switchboard/guard.sh
ExecStop=/usr/lib/switchboard/tproxy-rollback.sh

[Install]
WantedBy=multi-user.target
