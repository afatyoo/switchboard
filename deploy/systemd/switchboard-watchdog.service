[Unit]
Description=Switchboard fail-open watchdog
After=network-online.target netfilter-persistent.service haproxy.service switchboard-proxy.service

[Service]
ExecStart=/usr/bin/switchboard watchdog
Restart=always
RestartSec=2
# Needs root for iptables.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
# Defence in depth (#20): the watchdog reads files written by less privileged
# processes; cap its memory so a bad input cannot exhaust the host.
MemoryMax=256M

[Install]
WantedBy=multi-user.target
